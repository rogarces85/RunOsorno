{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "runosorno",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": [
    // APIs de Node.js: bcryptjs, mysql2, exceljs y @react-pdf/renderer
    // necesitan `Buffer`, `crypto` y streams.
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Pide más CPU por petición. La documentación de Cloudflare fija 10 ms en el
  // plan Free (y 30 s en el de pago, configurable hasta 5 min), así que en
  // Workers Free esto puede ser ignorado: se deja puesto porque no cuesta
  // nada y, si el runtime lo acepta, el arranque en frío (120-680 ms medidos)
  // deja de tumbar las peticiones. Medir tras el despliegue: si los 503
  // `exceededCpu` siguen igual, el plan Free lo está ignorando.
  "limits": {
    "cpu_ms": 30000
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "runosorno"
    }
  ],
  "hyperdrive": [
    {
      // Pool de conexiones y caché de consultas en el edge hacia el MySQL de
      // Aiven. `lib/db/index.ts` lee `env.HYPERDRIVE.connectionString` en vez
      // de `DATABASE_URL`, porque un Worker no puede abrir sockets TCP sueltos.
      "binding": "HYPERDRIVE",
      "id": "1bffd76cc20d423690c4079891d596eb",
      // Solo para `wrangler dev`/`preview`: emula el binding contra el MySQL de
      // XAMPP. Sin esto, wrangler no puede resolver los bindings en local y el
      // deploy falla con "no local hyperdrive connection string".
      "localConnectionString": "mysql://root:@localhost:3306/runosorno"
    }
  ],
  "vars": {
    // Solo se usa para armar los enlaces de los correos. Va como variable (y no
    // como secreto) porque no es informacion sensible, pero tampoco lleva el
    // prefijo NEXT_PUBLIC_: esas se incrustan en el bundle al compilar y
    // quedaria clavada al valor que tuviera en ese momento.
    "APP_URL": "https://runosorno.online",
    // Dominio propio verificado en Resend (2026-10-21, region sa-east-1): los
    // correos salen de `no-reply@runosorno.online` y llegan a cualquier
    // destinatario. Antes se usaba `onboarding@resend.dev`, que solo entrega
    // al correo dueno de la cuenta. Ver `docs/dominio.md`.
    "RESEND_FROM": "RunOsorno <no-reply@runosorno.online>",
    // Las respuestas a los correos van al buzón del administrador (un Gmail no
    // puede ser `from` en Resend porque el dominio no es verificable).
    "RESEND_REPLY_TO": "RunOsorno <rodrigo.garces.guerrero@gmail.com>"
  },
  "r2_buckets": [
    {
      // Caché incremental de Next (ISR/SSG). La crea OpenNext sola si no
      // existe, pero declararla aquí hace el binding explícito.
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "runosorno-cache"
    },
    {
      // Avatares de los usuarios (Fase 29). Bucket privado: la app sirve las
      // imágenes con URLs firmadas que genera en `lib/services/avatar.service`.
      "binding": "AVATARS",
      "bucket_name": "runosorno-avatars"
    }
  ]
}
