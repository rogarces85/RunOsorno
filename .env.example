# Base de datos (MySQL) — desarrollo local
DATABASE_URL="mysql://root:@localhost:3306/runosorno"

# Correo (Resend). Sin RESEND_API_KEY los correos se registran en la consola y
# no se envian. RESEND_FROM debe ser un remitente verificado en Resend; en
# produccion, mientras no haya dominio propio, se usa onboarding@resend.dev
# (solo entrega al correo dueno de la cuenta).
RESEND_API_KEY=""
RESEND_FROM="RunOsorno <no-reply@runosorno.cl>"

# URL publica de la app. Solo se usa para los enlaces de los correos, por eso no
# lleva el prefijo NEXT_PUBLIC_: las variables publicas se incrustan en el build.
APP_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible). Si estan vacios, los avatares se guardan
# localmente en .data/avatars/ (solo desarrollo). En produccion van como
# secretos del Worker: `wrangler secret put R2_ACCESS_KEY_ID`, etc.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="runosorno-avatars"

# Sentry (Fase 44). Si SENTRY_DSN esta vacio el SDK no se carga y la app
# funciona igual, asi que en desarrollo se puede dejar sin configurar.
# SENTRY_DSN: solo servidor (Worker: `wrangler secret put SENTRY_DSN`).
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Token de "auth tokens" de Sentry. Solo se usa al compilar, para subir los
# source maps; nunca se envia al navegador ni se guarda en el bundle.
SENTRY_AUTH_TOKEN=""
# Entorno que se ve en Sentry. Por defecto se deduce de NODE_ENV.
SENTRY_ENVIRONMENT=""
SENTRY_RELEASE=""
# El DSN del navegador si lleva prefijo NEXT_PUBLIC_ porque Next solo
# incrusta en el bundle del cliente las variables con ese prefijo. No es un
# secreto, pero queda clavado en el build: cambiarlo exige recompilar.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_RELEASE=""
