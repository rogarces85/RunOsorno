RESEND_FROM="RunOsorno <no-reply@runosorno.cl>"
# URL publica de la app. Solo se usa para los enlaces de los correos, por eso no
# lleva el prefijo NEXT_PUBLIC_: las variables publicas se incrustan en el build.
APP_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible). Si estan vacios, los avatares se guardan
# localmente en .data/avatars/ (solo desarrollo).
