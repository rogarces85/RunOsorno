# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# cloudflare
/.wrangler/
# Bundle que genera OpenNext para Cloudflare Workers (Fase 43)
/.open-next/
# Tipos de bindings generados por `wrangler types`
/cloudflare-env.d.ts

# avatares locales (dev sin R2)
/.data/

# archivos generados al verificar exportaciones
/.export-check/

# volcados de la base: contienen hashes de contrasena, nunca al repositorio
/db/dumps/

# notas locales con tokens/secretos pegados (no al repositorio)
/Cloudflare.txt
*.secret.txt

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Secretos locales de `wrangler dev` (equivalente a .env, pero para Cloudflare)
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
